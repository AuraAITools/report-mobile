{
  "name": "report-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --coverage --passWithNoTests",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:keycloak:start": "bash e2e/keycloak/start.sh",
    "e2e:keycloak:stop": "bash e2e/keycloak/stop.sh",
    "e2e:test": "npx cucumber-js --config e2e/cucumber.js",
    "e2e:test:ios": "DETOX_CONFIGURATION=ios.sim.debug npx cucumber-js --config e2e/cucumber.js",
    "e2e:test:android": "DETOX_CONFIGURATION=android.emu.debug npx cucumber-js --config e2e/cucumber.js",
    "e2e:report": "npx ts-node e2e/generate-report.ts",
    "e2e:run:ios": "npm run e2e:keycloak:start && npm run e2e:build:ios && npm run e2e:test:ios && npm run e2e:report; npm run e2e:keycloak:stop",
    "e2e:run:android": "npm run e2e:keycloak:start && npm run e2e:build:android && npm run e2e:test:android && npm run e2e:report; npm run e2e:keycloak:stop",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.37.1",
    "axios": "^1.7.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "base-64": "^1.0.0",
    "date-fns": "^4.0.0-beta.1",
    "expo": "^56.0.8",
    "expo-auth-session": "~56.0.13",
    "expo-constants": "~56.0.16",
    "expo-dev-client": "~56.0.18",
    "expo-device": "~56.0.4",
    "expo-env": "^1.1.1",
    "expo-font": "~56.0.5",
    "expo-image-picker": "~56.0.15",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.13",
    "expo-local-authentication": "~56.0.4",
    "expo-notifications": "~56.0.15",
    "expo-router": "~56.2.8",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "i18next": "^26.0.5",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.72.1",
    "react-i18next": "^17.0.3",
    "react-native": "0.85.3",
    "react-native-elements": "^3.4.3",
    "react-native-get-random-values": "^1.11.0",
    "react-native-gifted-charts": "^1.4.10",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "tailwindcss": "^3.4.17",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@cucumber/cucumber": "^12.8.1",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/client-preset": "^5.3.0",
    "@graphql-codegen/schema-ast": "^6.0.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@parcel/watcher": "^2.5.6",
    "@testing-library/react-native": "^13.3.3",
    "@types/base-64": "^1.0.2",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.14",
    "detox": "^20.50.1",
    "graphql": "^16.14.0",
    "jest": "^29.2.1",
    "jest-cucumber": "^4.5.0",
    "jest-expo": "~56.0.4",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "react-test-renderer": "19.2.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
