{
  "name": "report-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --coverage --passWithNoTests",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:keycloak:start": "bash e2e/keycloak/start.sh",
    "e2e:keycloak:stop": "bash e2e/keycloak/stop.sh",
    "e2e:test": "npx cucumber-js --config e2e/cucumber.js",
    "e2e:test:ios": "DETOX_CONFIGURATION=ios.sim.debug npx cucumber-js --config e2e/cucumber.js",
    "e2e:test:android": "DETOX_CONFIGURATION=android.emu.debug npx cucumber-js --config e2e/cucumber.js",
    "e2e:report": "npx ts-node e2e/generate-report.ts",
    "e2e:run:ios": "npm run e2e:keycloak:start && npm run e2e:build:ios && npm run e2e:test:ios && npm run e2e:report; npm run e2e:keycloak:stop",
    "e2e:run:android": "npm run e2e:keycloak:start && npm run e2e:build:android && npm run e2e:test:android && npm run e2e:report; npm run e2e:keycloak:stop"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@react-native-community/netinfo": "11.1.0",
    "@react-navigation/native": "^6.0.2",
    "@sentry/react-native": "^5.36.0",
    "@tanstack/react-query": "^5.37.1",
    "axios": "^1.7.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "base-64": "^1.0.0",
    "date-fns": "^4.0.0-beta.1",
    "expo": "~50.0.14",
    "expo-auth-session": "~5.4.0",
    "expo-constants": "~15.4.6",
    "expo-dev-client": "~3.3.12",
    "expo-device": "~5.9.4",
    "expo-env": "^1.1.1",
    "expo-font": "~11.10.3",
    "expo-image-picker": "~14.7.1",
    "expo-linear-gradient": "~12.7.2",
    "expo-linking": "~6.2.2",
    "expo-local-authentication": "~13.8.0",
    "expo-notifications": "~0.27.8",
    "expo-router": "~3.4.8",
    "expo-secure-store": "~12.8.1",
    "expo-splash-screen": "~0.26.4",
    "expo-status-bar": "~1.11.1",
    "expo-system-ui": "~2.9.3",
    "expo-web-browser": "~12.8.2",
    "i18next": "^26.0.5",
    "nativewind": "^4.1.23",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.72.1",
    "react-i18next": "^17.0.3",
    "react-native": "0.73.6",
    "react-native-elements": "^3.4.3",
    "react-native-get-random-values": "^1.11.0",
    "react-native-gifted-charts": "^1.4.10",
    "react-native-reanimated": "^3.16.2",
    "react-native-safe-area-context": "^4.14.1",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.6",
    "tailwindcss": "^3.4.17",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@cucumber/cucumber": "^12.8.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/base-64": "^1.0.2",
    "@types/node": "^25.6.0",
    "@types/react": "~18.2.45",
    "detox": "^20.50.1",
    "jest": "^29.2.1",
    "jest-cucumber": "^4.5.0",
    "jest-expo": "~50.0.4",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "react-test-renderer": "18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3"
  },
  "private": true
}
